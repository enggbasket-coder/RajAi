{
  "name": "trackwise",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @trackwise/web dev",
    "build": "pnpm --filter @trackwise/web build",
    "start": "pnpm --filter @trackwise/web start",
    "desktop": "pnpm --filter @trackwise/desktop start",
    "db:generate": "pnpm --filter @trackwise/database generate",
    "db:migrate": "pnpm --filter @trackwise/database migrate",
    "db:deploy": "pnpm --filter @trackwise/database deploy",
    "db:seed": "pnpm --filter @trackwise/database seed",
    "db:reset": "pnpm --filter @trackwise/database reset",
    "test": "pnpm --filter @trackwise/core test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm --filter @trackwise/web lint"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "electron"
    ]
  }
}
