# ---- copy to the repository root as .env on the server ----
APP_DOMAIN=trackwise.plusbrains.ai
APP_URL=https://trackwise.plusbrains.ai

# Postgres password for the bundled db service (DATABASE_URL is derived from it in docker-compose.yml)
POSTGRES_PASSWORD=CHANGE-ME-long-random

# Generate each with: openssl rand -base64 48
AUTH_SECRET=CHANGE-ME
ENCRYPTION_KEY=CHANGE-ME

# Providers: keep mock until Meta / Telegram credentials are configured in the UI
WHATSAPP_PROVIDER=mock
TELEGRAM_PROVIDER=mock
META_GRAPH_API_VERSION=v21.0
# Optional env defaults (per-organization values set in the UI take precedence)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ASSIGNMENT_TEMPLATE_NAME=
# Shared platform number: when META_PHONE_NUMBER_ID (+ META_ACCESS_TOKEN in meta mode) is set, organizations without
# their own WhatsApp connection send and receive through it; inbound messages are routed by the sender's verified phone.
META_DISPLAY_PHONE_NUMBER=
META_DISPLAY_NAME=Trackwise by PlusBrains
# Per-conversation rate used for the estimated-cost column on /platform/usage (Meta's invoice is the source of truth)
WHATSAPP_CONVERSATION_RATE=
WHATSAPP_CONVERSATION_CURRENCY=INR
# Comma-separated emails allowed to see cross-organization usage (/platform/usage)
PLATFORM_ADMIN_EMAILS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Seed the Trackwise Demo organization on first start (set back to false afterwards)
SEED_DEMO=true
# Never true in production
ENABLE_DEV_TOOLS=false
