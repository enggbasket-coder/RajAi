# ---- Core ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trackwise
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trackwise_test
AUTH_SECRET=change-me-to-a-long-random-string
# 32+ chars; used to encrypt provider tokens at rest. Falls back to AUTH_SECRET if unset.
ENCRYPTION_KEY=
APP_URL=http://localhost:3000

# ---- WhatsApp (Meta WhatsApp Business Cloud API) ----
# mock | meta
WHATSAPP_PROVIDER=mock
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
# Approved template used when outside the 24h customer-service window (optional)
META_ASSIGNMENT_TEMPLATE_NAME=

# ---- Telegram (official Bot API) ----
# mock | telegram
TELEGRAM_PROVIDER=mock
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ---- Object storage (reserved for Phase 2 screenshots; unused in MVP) ----
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Dev ----
# Enables /dev/messaging mock console and /api/dev/* routes. Never enable in production.
ENABLE_DEV_TOOLS=true
